# Docker Compose Configuration
COMPOSE_PROJECT_NAME=shatter

# Database Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=shatter
POSTGRES_USER=shatter_user
POSTGRES_PASSWORD=changeme_secure_password

# Backend Configuration
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0
LOG_LEVEL=INFO
DEFAULT_POLL_INTERVAL=5

# Frontend Configuration
# VITE_API_URL - Leave commented out to enable auto-detection based on browser hostname
# This allows network access from other devices (phones, tablets, other computers)
# Only set this if you need to override the auto-detection
# VITE_API_URL=http://localhost:8000

# Security (optional)
# SECRET_KEY=generate_a_secure_random_key_here
# ENABLE_AUTH=false
