# Docker Compose Configuration
COMPOSE_PROJECT_NAME=shatter

# Database Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=shatter
POSTGRES_USER=shatter_user
POSTGRES_PASSWORD=changeme_secure_password

# Backend Configuration
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0
LOG_LEVEL=INFO
DEFAULT_POLL_INTERVAL=5
# Host path mounted for Sync local-folder picker (macOS default shown)
FTP_SYNC_LOCAL_BROWSE_HOST_PATH=/Users

# Frontend Configuration
# VITE_API_URL - Leave commented out to enable auto-detection based on browser hostname
# This allows network access from other devices (phones, tablets, other computers)
# Only set this if you need to override the auto-detection
# VITE_API_URL=http://localhost:8000

# Security (optional)
# SECRET_KEY=generate_a_secure_random_key_here
# ENABLE_AUTH=false

# Notifications — SMTP (email / email-to-SMS gateway)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your.email@gmail.com
# SMTP_PASSWORD=your_app_password   # Use Gmail App Password, not account password
# SMTP_START_TLS=true
#
# Email-to-SMS carrier gateways (use as recipient address in channel config):
#   AT&T:     5551234567@txt.att.net
#   T-Mobile: 5551234567@tmomail.net
#   Verizon:  5551234567@vtext.com
