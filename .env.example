# Production Environment Variables
# Copy this file to .env and update with your production values

# PostgreSQL Configuration
POSTGRES_DB=shatter
POSTGRES_USER=shatter_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Backend Configuration
SECRET_KEY=CHANGE_ME_GENERATE_STRONG_SECRET_KEY
BACKEND_PORT=8000
LOG_LEVEL=WARNING
DEFAULT_POLL_INTERVAL=5

# Frontend Configuration
# Set this to the URL where your backend API will be accessible
# For same-machine deployment, use http://localhost:8000
# For remote backend, use http://your-backend-ip:8000
VITE_API_URL=http://localhost:8000

# Redis Configuration (optional)
# Leave empty to disable Redis password authentication
REDIS_PASSWORD=
