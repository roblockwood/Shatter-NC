# Docker Compose Configuration
COMPOSE_PROJECT_NAME=shatter

# Database Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=shatter
POSTGRES_USER=shatter_user
POSTGRES_PASSWORD=changeme_secure_password

# Backend Configuration
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0
LOG_LEVEL=INFO
DEFAULT_POLL_INTERVAL=5

# Frontend Configuration
# VITE_API_URL - Leave commented out to enable auto-detection based on browser hostname
# This allows network access from other devices (phones, tablets, other computers)
# Only set this if you need to override the auto-detection
# VITE_API_URL=http://localhost:8000

# Optional Host Relay (macOS Docker Desktop CNC workaround)
# Set enabled=1 and target host when container cannot directly reach machine Telnet port.
# Leave disabled for normal deployments.
SHATTER_TELNET_RELAY_ENABLED=0
SHATTER_TELNET_RELAY_LISTEN_HOST=0.0.0.0
SHATTER_TELNET_RELAY_LISTEN_PORT=10000
SHATTER_TELNET_RELAY_TARGET_HOST=
SHATTER_TELNET_RELAY_TARGET_PORT=10000

# Optional host-side FTP passive proxy (for container-to-machine routing issues)
SHATTER_FTP_PROXY_ENABLED=0
SHATTER_FTP_PROXY_LISTEN_HOST=0.0.0.0
SHATTER_FTP_PROXY_LISTEN_PORT=2121
SHATTER_FTP_PROXY_TARGET_HOST=
SHATTER_FTP_PROXY_TARGET_PORT=21
SHATTER_FTP_PROXY_DATA_LISTEN_HOST=0.0.0.0
SHATTER_FTP_PROXY_DATA_TIMEOUT=30
# Optional explicit PASV host to advertise to client (blank = auto)
SHATTER_FTP_PROXY_ADVERTISE_HOST=

# Optional host-side SC2 HTTP relay for Kaeser compressor polling
SHATTER_SC2_RELAY_ENABLED=0
SHATTER_SC2_RELAY_LISTEN_HOST=0.0.0.0
SHATTER_SC2_RELAY_LISTEN_PORT=8082
SHATTER_SC2_RELAY_TARGET_HOST=
SHATTER_SC2_RELAY_TARGET_PORT=80

# Security (optional)
# SECRET_KEY=generate_a_secure_random_key_here
# ENABLE_AUTH=false
