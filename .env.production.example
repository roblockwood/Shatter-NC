# Production Environment Configuration
# Copy this file to .env (or .env.production) and update with your production values

# Database Configuration
POSTGRES_DB=shatter
POSTGRES_USER=shatter_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Backend Configuration
SECRET_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
BACKEND_PORT=8000
LOG_LEVEL=WARNING
DEFAULT_POLL_INTERVAL=5

# Frontend Configuration
# Set to your backend API URL:
# - Same machine: http://localhost:8000
# - Remote backend: http://your-backend-ip-or-hostname:8000
VITE_API_URL=http://localhost:8000

# Redis Configuration (optional)
# Leave empty to disable Redis password authentication
REDIS_PASSWORD=
