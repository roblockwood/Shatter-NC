# Production Environment Configuration
# IMPORTANT: Copy this to .env.production and update with secure values

# Docker Compose Configuration
COMPOSE_PROJECT_NAME=shatter

# Database Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=shatter
POSTGRES_USER=shatter_user
# SECURITY: Generate a strong password
POSTGRES_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD

# Backend Configuration
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0
LOG_LEVEL=WARNING
DEFAULT_POLL_INTERVAL=5

# Frontend Configuration
# VITE_API_URL - Leave commented out to enable auto-detection based on browser hostname
# This allows network access from other devices (phones, tablets, other computers)
# Only set this if you need to override auto-detection (e.g., for a specific domain/IP)
# VITE_API_URL=http://your-server-ip:8000

# Security
# SECURITY: Generate a secure random key with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_TO_SECURE_SECRET_KEY
ENABLE_AUTH=true

# Optional: SSL/TLS Configuration
# SSL_CERT_PATH=/path/to/cert.pem
# SSL_KEY_PATH=/path/to/key.pem
