# Production Environment Configuration
# IMPORTANT: Copy this to .env.production and update with secure values

# Docker Compose Configuration
COMPOSE_PROJECT_NAME=shatter
# Pin ghcr.io image tag: latest, v1.2.3, or a commit SHA (see GitHub Releases / Packages)
# IMAGE_TAG=latest
# GITHUB_OWNER=roblockwood
# GITHUB_REPO=shatter-nc

# Database Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=shatter
POSTGRES_USER=shatter_user
# SECURITY: Generate a strong password
POSTGRES_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD

# Backend Configuration
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0
LOG_LEVEL=WARNING
DEFAULT_POLL_INTERVAL=5
# Host path mounted for Sync local-folder picker (set for your platform)
FTP_SYNC_LOCAL_BROWSE_HOST_PATH=/Users

# Frontend Configuration
# VITE_API_URL - Leave commented out to enable auto-detection based on browser hostname
# This allows network access from other devices (phones, tablets, other computers)
# Only set this if you need to override auto-detection (e.g., for a specific domain/IP)
# VITE_API_URL=http://your-server-ip:8000

# Security
# SECURITY: Generate a secure random key with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_TO_SECURE_SECRET_KEY
# Legacy — no effect (Shatter has no user/API auth; see SECURITY.md)
ENABLE_AUTH=false
# JSON array of allowed browser origins for your shop network
CORS_ORIGINS='["http://localhost:3000","http://localhost"]'

# Optional: SSL/TLS Configuration
# SSL_CERT_PATH=/path/to/cert.pem
# SSL_KEY_PATH=/path/to/key.pem

# Notifications — SMTP (email / email-to-SMS gateway)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your.email@gmail.com
# SMTP_PASSWORD=your_app_password   # Use Gmail App Password, not account password
# SMTP_START_TLS=true
#
# Email-to-SMS carrier gateways (use as recipient address in channel config):
#   AT&T:     5551234567@txt.att.net
#   T-Mobile: 5551234567@tmomail.net
#   Verizon:  5551234567@vtext.com
