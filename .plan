## Database Schema (Draft)

```sql
-- Machines registry
CREATE TABLE machines (
    id SERIAL PRIMARY KEY,
    name VARCHAR(255) NOT NULL,
    model VARCHAR(100),  -- e.g., "Brother CNC"
    ip_address VARCHAR(45) NOT NULL,  -- IPv4 or IPv6
    ftp_port INT DEFAULT 21,
    http_port INT DEFAULT 80,
    ftp_username VARCHAR(255) DEFAULT 'anonymous',
    ftp_password VARCHAR(255) DEFAULT 'anonymous',
    location VARCHAR(255),  -- e.g., "Production Floor A"
    tags JSONB,  -- ["production", "floor-a"]
    poll_interval_seconds INT DEFAULT 5,
    enabled BOOLEAN DEFAULT TRUE,
    created_at TIMESTAMPTZ DEFAULT NOW(),
    updated_at TIMESTAMPTZ DEFAULT NOW(),
    last_seen_at TIMESTAMPTZ,
    connection_status VARCHAR(20) DEFAULT 'unknown'  -- online, offline, unknown
);

-- Machine status snapshots
CREATE TABLE machine_status (
    id SERIAL PRIMARY KEY,
    machine_id INT REFERENCES machines(id) ON DELETE CASCADE,
    timestamp TIMESTAMPTZ NOT NULL,
    status VARCHAR(50),  -- running, stopped, error, alarm
    program_name VARCHAR(255),
    cycle_time_seconds INT,
    cutting_time_seconds INT,
    power_on_hours DECIMAL
);
SELECT create_hypertable('machine_status', 'timestamp');
CREATE INDEX idx_machine_status_machine_id ON machine_status(machine_id, timestamp DESC);

-- Alarm events
CREATE TABLE alarms (
    id SERIAL PRIMARY KEY,
    machine_id INT REFERENCES machines(id) ON DELETE CASCADE,
    timestamp TIMESTAMPTZ NOT NULL,
    alarm_code VARCHAR(50),
    alarm_message TEXT,
    severity VARCHAR(20),
    cleared_at TIMESTAMPTZ
);
SELECT create_hypertable('alarms', 'timestamp');
CREATE INDEX idx_alarms_machine_id ON alarms(machine_id, timestamp DESC);

-- Production runs
CREATE TABLE production_runs (
    id SERIAL PRIMARY KEY,
    machine_id INT REFERENCES machines(id) ON DELETE CASCADE,
    program_name VARCHAR(255) NOT NULL,
    started_at TIMESTAMPTZ NOT NULL,
    completed_at TIMESTAMPTZ,
    cycle_time_seconds INT,
    parts_count INT,
    status VARCHAR(50)  -- completed, aborted, error
);
SELECT create_hypertable('production_runs', 'started_at');
CREATE INDEX idx_production_runs_machine_id ON production_runs(machine_id, started_at DESC);

-- NC Programs (metadata)
CREATE TABLE programs (
    id SERIAL PRIMARY KEY,
    name VARCHAR(255) UNIQUE NOT NULL,  -- Friendly name (e.g., "bracket_v2")
    o_number INT UNIQUE,  -- O-number (2000-3999), assigned from pool
    current_version_id INT,
    created_at TIMESTAMPTZ DEFAULT NOW(),
    updated_at TIMESTAMPTZ DEFAULT NOW()
);

-- O-number allocation pool (O2000-O3999 range)
CREATE TABLE o_number_allocations (
    o_number INT PRIMARY KEY CHECK (o_number >= 2000 AND o_number <= 3999),
    program_id INT REFERENCES programs(id) ON DELETE SET NULL,
    allocated_at TIMESTAMPTZ,
    last_used_at TIMESTAMPTZ,
    is_available BOOLEAN DEFAULT TRUE
);

-- Pre-populate O-number pool (2000 numbers available)
INSERT INTO o_number_allocations (o_number)
SELECT generate_series(2000, 3999);

-- Program versions
CREATE TABLE program_versions (
    id SERIAL PRIMARY KEY,
    program_id INT REFERENCES programs(id),
    version_number INT NOT NULL,
    content TEXT NOT NULL,
    content_hash CHAR(64) NOT NULL,  -- SHA256
    file_size INT,
    line_count INT,
    tool_list JSONB,  -- [{"tool": "T01", "name": "1/4 END MILL", ...}]
    uploaded_at TIMESTAMPTZ DEFAULT NOW(),
    uploaded_by VARCHAR(255),
    notes TEXT,
    UNIQUE(program_id, version_number)
);

-- Machine program deployments (tracks which version is on which machine)
CREATE TABLE machine_program_deployments (
    id SERIAL PRIMARY KEY,
    machine_id INT REFERENCES machines(id) ON DELETE CASCADE,
    program_id INT REFERENCES programs(id) ON DELETE CASCADE,
    version_id INT REFERENCES program_versions(id) ON DELETE CASCADE,
    deployed_at TIMESTAMPTZ DEFAULT NOW(),
    deployed_by VARCHAR(255),
    status VARCHAR(20) DEFAULT 'active',  -- active, archived
    UNIQUE(machine_id, program_id, status)  -- Only one active deployment per machine/program
);
CREATE INDEX idx_deployments_machine_id ON machine_program_deployments(machine_id);
CREATE INDEX idx_deployments_program_id ON machine_program_deployments(program_id);

-- Tool table snapshots
CREATE TABLE tool_snapshots (
    id SERIAL PRIMARY KEY,
    machine_id INT REFERENCES machines(id) ON DELETE CASCADE,
    timestamp TIMESTAMPTZ NOT NULL,
    tool_data JSONB NOT NULL  -- Full tool table from /tool endpoint
);
SELECT create_hypertable('tool_snapshots', 'timestamp');
CREATE INDEX idx_tool_snapshots_machine_id ON tool_snapshots(machine_id, timestamp DESC);

-- Workpiece counter history
CREATE TABLE counter_history (
    id SERIAL PRIMARY KEY,
    machine_id INT REFERENCES machines(id) ON DELETE CASCADE,
    timestamp TIMESTAMPTZ NOT NULL,
    counter_1 INT,
    counter_2 INT,
    counter_3 INT,
    counter_4 INT
);
SELECT create_hypertable('counter_history', 'timestamp');
CREATE INDEX idx_counter_history_machine_id ON counter_history(machine_id, timestamp DESC);
```

---

## Security Considerations

**Network Isolation:**
- Dashboard typically runs on isolated shop floor network
- No internet access required
- Consider firewall rules between dashboard and CNC

**Authentication (Optional):**
- Basic auth for multi-user environments
- Role-based access (operator vs. programmer)
- Per-machine access control (restrict users to specific machines)
- Audit log for file uploads and machine configuration changes

**Data Validation:**
- Sanitize G-code uploads (prevent malicious code injection)
- File size limits
- Allowed file extensions (.NC, .nc only)

**Backup:**
- Regular PostgreSQL backups
- Export NC program versions to external storage

---

## Open Questions / Future Considerations

1. **Mobile responsive:** Tablet/phone access for operators?
2. **Notifications:** Email/Slack alerts for alarms (per machine or fleet-wide)?
3. **Machine learning:** Predict cycle time, detect anomalies across fleet?
4. **3D Smoothing Viewer:** The CNC has a hidden 3D viewer endpoint - integrate?
5. **MTConnect/FOCAS:** If available, use more robust protocols?
6. **Edge cases:** Handle CNC reboot, network loss gracefully
7. **Performance:** How much historical data to keep? Aggregation strategy for large fleets?
8. **Scalability:** How many machines can one instance handle? Need multiple backend workers?
9. **Cross-machine program sync:** Automatically keep certain programs in sync across machines?
10. **Machine groups/hierarchies:** Department → Cell → Machine organization?

