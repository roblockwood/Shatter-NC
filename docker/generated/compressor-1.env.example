# Copy to compressor-1.env or let Shatter create it when you save Kaeser credentials.
# Replace id in filename with your compressor row id. Restart sidecar after changes.
# Use http:// if Connect is on port 80; https:// if TLS on 443 (or https://host:PORT).

KAESER_ADDRESS=http://192.168.86.101
KAESER_USERNAME=readonly
KAESER_PASSWORD=changeme
MQTT_HOST=mqtt
MQTT_PORT=1883
MQTT_USER=dev
MQTT_PASS=dev
MQTT_TOPIC_ROOT=kaeser-sc2-01
LOG_LEVEL=info
