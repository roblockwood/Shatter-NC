# Copy to kaeser-sc2-api.env (gitignored) for docker-compose.
# KAESER_ADDRESS = Sigma Control 2 / Kaeser Connect base URL:
#   http://<ip>     — common on LAN (port 80)
#   https://<ip>    — TLS on 443 (often self-signed)
#   https://<ip>:PORT — non-default HTTPS port
# If logs show ECONNREFUSED on :443, use http:// instead.
# One kaeser-sc2-api container per compressor; use a unique MQTT_TOPIC_ROOT per machine.

KAESER_ADDRESS=http://192.168.1.50
KAESER_USERNAME=readonly
KAESER_PASSWORD=changeme

MQTT_HOST=mqtt
MQTT_PORT=1883
MQTT_USER=dev
MQTT_PASS=dev
MQTT_TOPIC_ROOT=kaeser-sc2-01

LOG_LEVEL=info
