# Required
POSTGRES_PASSWORD=changeme_strong_password
SECRET_KEY=changeme_generate_random

# Image source (public GHCR packages)
GITHUB_OWNER=roblockwood
GITHUB_REPO=shatter-nc-install
IMAGE_TAG=latest

# Optional tuning
LOG_LEVEL=WARNING
DEFAULT_POLL_INTERVAL=5

# MQTT (used for compressor telemetry sidecars/integration)
MQTT_PORT=1883
MQTT_BROKER_HOST=mqtt
MQTT_BROKER_PORT=1883
MQTT_USER=
MQTT_PASS=

# Compressor sampling/tuning
COMPRESSOR_REST_REFRESH_SECONDS=10
COMPRESSOR_STATUS_SAMPLE_MIN_INTERVAL_SECONDS=1
COMPRESSOR_STATUS_SAMPLES_RAW_DAYS=14

# Sidecar integration
KAESER_SIDECAR_ENV_DIR=/docker/generated

# Optional: Kaeser SC2 sidecar (enable compose profile "kaeser")
KAESER_SC2_API_PORT=3004
KAESER_ADDRESS=
KAESER_USERNAME=
KAESER_PASSWORD=
MQTT_TOPIC_ROOT=kaeser-sc2-01
KAESER_LOG_LEVEL=info

# Host ports (change if you already use 80/8000/5432)
FRONTEND_PORT=80
BACKEND_PORT=8000
POSTGRES_HOST_PORT=5432
